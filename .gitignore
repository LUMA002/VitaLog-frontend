# Environment Variables & Secrets
# (Files to save URLs for APIs and other public keys)
.env
.env.*
!.env.example

# Android Keystore / Release Signing
# CRITICAL: Never commit signature certificates to git
*.jks
*.keystore
key.properties
android/key.properties
android/app/key.properties

# Local App Data / SQLite (if you're testing on Windows/Mac)
*.sqlite
*.db

# VS Code Workspace files (so that local window settings don't get pushed to git)
.vscode/
*.code-workspace
